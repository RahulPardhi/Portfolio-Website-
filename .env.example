ASTRO_TELEMETRY_DISABLED=1

# Gmail SMTP Configuration for Contact Form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# Enter your 16-character Google App Password below (without spaces)
# How to get it: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_PASS=your_16_character_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com