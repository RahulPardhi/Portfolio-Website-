---
import { Icon } from 'astro-icon/components'

const currentYear = new Date().getFullYear()
---

<footer
    class='w-full py-6 mt-10 text-center text-sm text-gray-500 dark:text-gray-400'
>
    <p class='bg-secondary-background font-medium'>
        © {currentYear} Rahul Pardhi. All rights reserved.
    </p>
    <p class='text-xs text-gray-500 mt-1.5'>
        Email: <a href='mailto:pardhirahul2004@gmail.com' class='hover:underline text-foreground/80'>pardhirahul2004@gmail.com</a> • Phone: <a href='tel:+918788221424' class='hover:underline text-foreground/80'>+91 8788221424</a>
    </p>
    <div class='flex justify-center gap-4 mt-3'>
        <a
            href='https://github.com/RahulPardhi'
            target='_blank'
            rel='noopener noreferrer'
            title='GitHub'
            class='hover:text-primary transition-colors'
            aria-label='GitHub'
        >
            <Icon name='mdi:github' class='h-6 w-6' />
        </a>
        <a
            href='https://www.linkedin.com/in/rahul-pardhi-b41a272a6'
            target='_blank'
            rel='noopener noreferrer'
            title='LinkedIn'
            class='hover:text-primary transition-colors'
            aria-label='LinkedIn'
        >
            <Icon name='mdi:linkedin' class='h-6 w-6' />
        </a>
        <a
            href='mailto:pardhirahul2004@gmail.com'
            title='Email'
            class='hover:text-primary transition-colors'
            aria-label='Email'
        >
            <Icon name='mdi:email-outline' class='h-6 w-6' />
        </a>
        <a
            href='tel:+918788221424'
            title='Phone: +91 8788221424'
            class='hover:text-primary transition-colors'
            aria-label='Phone'
        >
            <Icon name='mdi:phone' class='h-6 w-6' />
        </a>
    </div>
</footer>
