---
import SocialsBox from './SocialsBox.astro'
import SendEmail from '@lucide/astro/icons/mail'
import PhoneCall from '@lucide/astro/icons/phone'

type Props = {}
const {} = Astro.props
---

<section
    class='mx-auto my-8 flex max-w-3xl flex-col items-center text-center px-4 md:px-8'
>
    {/* Text & Socials */}
    <div class='flex flex-col items-center gap-4 w-full'>
        {/* Text Section */}
        <div>
            <h1 class='mb-2 text-4xl font-bold md:text-5xl tracking-tight'>
                Hi, I'm <span class='text-primary'>Rahul</span>
            </h1>
            <h2 class='text-foreground/90 text-xl leading-relaxed md:text-2xl font-medium max-w-2xl'>
                A Web Developer &amp; CSE Student living in Gondia, Maharashtra
            </h2>

            {/* Direct Contact Details */}
            <div class='mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-foreground/80'>
                <a
                    href='mailto:pardhirahul2004@gmail.com'
                    class='inline-flex items-center gap-2 font-medium hover:text-primary transition-colors py-1 px-2.5 rounded-md hover:bg-secondary'
                    title='Click to open email client'
                    aria-label='Send email to pardhirahul2004@gmail.com'
                >
                    <SendEmail class='h-4 w-4 text-emerald-500 shrink-0' />
                    <span>pardhirahul2004@gmail.com</span>
                </a>
                <span class='hidden sm:inline text-foreground/30'>•</span>
                <a
                    href='tel:+918788221424'
                    class='inline-flex items-center gap-2 font-medium hover:text-primary transition-colors py-1 px-2.5 rounded-md hover:bg-secondary'
                    title='Click to open phone dialer'
                    aria-label='Call +91 8788221424'
                >
                    <PhoneCall class='h-4 w-4 text-sky-500 shrink-0' />
                    <span>+91 8788221424</span>
                </a>
            </div>
        </div>

        <SocialsBox />
    </div>
</section>
