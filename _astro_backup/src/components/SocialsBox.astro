---
import SendEmail from '@lucide/astro/icons/mail'
import PhoneCall from '@lucide/astro/icons/phone'
import { Icon } from 'astro-icon/components'
---

<div
    class='flex items-center gap-4 sm:gap-6 rounded-2xl bg-secondary-background/80 px-5 py-2.5 shadow-lg backdrop-blur-sm border border-border/30'
>
    <a
        href='https://github.com/RahulPardhi'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='GitHub'
        title='Visit GitHub'
        class='inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border/60 bg-background text-foreground/80 hover:text-foreground hover:scale-110 hover:border-primary/50 transition-all duration-200'
    >
        <Icon
            name='mdi:github'
            class='h-5 w-5'
        />
    </a>

    <a
        href='https://www.linkedin.com/in/rahul-pardhi-b41a272a6'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='LinkedIn'
        title='Visit LinkedIn'
        class='inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border/60 bg-background text-[#0A66C2] hover:scale-110 hover:border-primary/50 transition-all duration-200'
    >
        <Icon
            name='mdi:linkedin'
            class='h-5 w-5'
        />
    </a>

    <a
        href='mailto:pardhirahul2004@gmail.com'
        aria-label='Email pardhirahul2004@gmail.com'
        title='Open Email application'
        class='inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border/60 bg-background text-emerald-500 hover:scale-110 hover:border-emerald-500/50 transition-all duration-200'
    >
        <SendEmail
            class='h-5 w-5'
        />
    </a>

    <a
        href='tel:+918788221424'
        aria-label='Call +91 8788221424'
        title='Open Phone dialer'
        class='inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border/60 bg-background text-sky-500 hover:scale-110 hover:border-sky-500/50 transition-all duration-200'
    >
        <PhoneCall
            class='h-5 w-5'
        />
    </a>
</div>
