---
import Layout from '@/layouts/Layout.astro'
import {
    Card,
    CardHeader,
    CardTitle,
    CardDescription,
    CardContent,
} from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Icon } from 'astro-icon/components'

const projects = [
    {
        title: 'Kishan Mitra AI',
        subtitle: 'Smart Farming Assistant',
        badge: 'Live Application',
        liveUrl: 'https://kishan-mitra-ai-1.onrender.com/',
        githubUrl: 'https://github.com/RahulPardhi',
        overview:
            'An AI-powered Smart Farming Assistant that helps farmers with weather updates, crop disease detection, soil analysis, AI-powered farming guidance, voice interaction, and multilingual support.',
        highlights: [
            'Built with 4 core modules: Gemini-powered interactive chatbot, crop disease computer-vision detection, soil nutrient analysis, and live weather forecast.',
            'Developed secure backend APIs with JWT authentication, MongoDB, and integrated 5+ services/APIs, including the Gemini API, weather API, custom detection model, and Web Speech API. ',
            'Added 3-language support (English, Hindi, Marathi) with voice assistance and a responsive dashboard, connecting AI, database, and external services into one production-ready application.',
        ],
        technologies: [
            'JavaScript',
            'Node.js',
            'Express',
            'MongoDB',
            'Gemini API',
            'Weather API',
            'Web Speech API',
            'JWT',
        ],
    },
    {
        title: 'Career Path',
        subtitle: 'Student Career Assistant',
        badge: 'AI Career Platform',
        liveUrl: null,
        githubUrl: 'https://github.com/RahulPardhi',
        overview:'Developed an AI-powered career assistant for resume analysis, skill-gap detection, job recommendations, and personalized learning roadmaps. ',
        highlights: [
            'Automated end-to-end resume parsing, skill extraction, and ATS compatibility scoring across varied candidate profiles.',
            'Tested the application on 50+ resumes to evaluate resume parsing, skill extraction, ATS scoring, and analysis across different resume formats. ',
            'Achieved 80% ATS accuracy during testing, improving keyword matching and identifying relevant skills for targeted job roles. ',
        ],
        technologies: [
            'Python',
            'React',
            'MongoDB',
            'JWT',
            'ATS Scoring',
            'Resume Parsing',
            'REST APIs',
        ],
    },
]
---

<Layout
    title='Projects'
    description='Featured projects engineered by Rahul Pardhi, including Kishan Mitra AI and Career Path.'
>
    <div class='relative max-w-3xl mx-auto py-8 px-4 lg:px-0 w-full space-y-6'>
        <div>
            <h2 class='text-2xl font-bold flex items-center gap-2 text-foreground'>
                Featured Projects
            </h2>
            <div class='h-1 w-36 bg-primary mt-2 mb-6 rounded-full'></div>
        </div>

        <div class='space-y-6'>
            {
                projects.map((project) => (
                    <Card className='bg-secondary-background border border-slate-200 dark:border-slate-800 shadow transition hover:shadow-md'>
                        <CardHeader className='flex flex-col sm:flex-row sm:justify-between sm:items-start gap-3'>
                            <div class='space-y-1'>
                                <div class='flex items-center gap-2'>
                                    <span class='inline-flex items-center rounded-md bg-primary/10 px-2 py-0.5 text-xs font-semibold text-primary border border-primary/20'>
                                        {project.badge}
                                    </span>
                                </div>
                                <CardTitle className='text-xl font-bold text-foreground pt-1'>
                                    {project.title}
                                </CardTitle>
                                <CardDescription className='text-sm font-medium text-foreground/70'>
                                    {project.subtitle}
                                </CardDescription>
                            </div>

                            <div class='flex items-center gap-2'>
                                {project.liveUrl && (
                                    <Button variant='default' size='sm' asChild>
                                        <a
                                            href={project.liveUrl}
                                            target='_blank'
                                            rel='noopener noreferrer'
                                            class='flex items-center gap-1.5'
                                        >
                                            <span>Live Demo</span>
                                            <Icon name='mdi:open-in-new' class='h-4 w-4' />
                                        </a>
                                    </Button>
                                )}
                                {project.githubUrl && (
                                    <Button variant='outline' size='sm' asChild>
                                        <a
                                            href={project.githubUrl}
                                            target='_blank'
                                            rel='noopener noreferrer'
                                            class='flex items-center gap-1.5'
                                            aria-label='View GitHub Repository'
                                        >
                                            <Icon name='mdi:github' class='h-4 w-4' />
                                            <span>Source</span>
                                        </a>
                                    </Button>
                                )}
                            </div>
                        </CardHeader>

                        <CardContent className='space-y-4'>
                            <p class='text-sm text-foreground/80 leading-relaxed'>
                                {project.overview}
                            </p>

                            <ul class='space-y-2 text-sm text-foreground/80 list-disc pl-5'>
                                {project.highlights.map((item) => (
                                    <li class='leading-relaxed'>{item}</li>
                                ))}
                            </ul>

                            <div class='pt-2 flex flex-wrap gap-1.5 border-t border-border/30'>
                                {project.technologies.map((tech) => (
                                    <span class='inline-flex items-center rounded-md bg-secondary px-2.5 py-1 text-xs font-medium text-foreground/80 border border-border/50'>
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        </CardContent>
                    </Card>
                ))
            }
        </div>
    </div>
</Layout>
