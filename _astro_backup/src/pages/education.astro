---
import {
    Card,
    CardHeader,
    CardTitle,
    CardDescription,
    CardContent,
} from '@/components/ui/card'
import Layout from '@/layouts/Layout.astro'

import GraduationCap from '@lucide/astro/icons/graduation-cap'
import Building from '@lucide/astro/icons/building'
import History from '@lucide/astro/icons/history'

const educationList = [
    {
        degree: 'Bachelor of Technology (B. Tech)',
        major: 'Computer Science and Engineering',
        institution: 'Tulsiramji Gaikwad Patil College of Engineering and Technology',
        location: 'Nagpur, Maharashtra',
        dates: 'July 2023 – July 2027',
        status: 'Pursuing (Undergraduate)',
        details:
            'Focusing on Core Computer Science, Data Structures & Algorithms, Database Management Systems, Operating Systems, Web Development, and Artificial Intelligence.',
    },
    {
        degree: 'Higher Secondary Certificate (12th Grade)',
        major: 'Science Stream (HSC)',
        institution: 'Late. Sarjabai Bhoyar Vidyalaya',
        location: 'Dawaniwada, Gondia',
        dates: 'Completed',
        status: '74.33%',
        details:
            'Completed Higher Secondary education with focus on Physics, Chemistry, and Mathematics.',
    },
    {
        degree: 'Secondary School Certificate (10th Grade)',
        major: 'General Academics (SSC)',
        institution: 'Late. Sarjabai Bhoyar Vidyalaya',
        location: 'Dawaniwada, Gondia',
        dates: 'Completed',
        status: '75.40%',
        details:
            'Completed Secondary School education with distinction in Mathematics and Science.',
    },
]
---

<Layout
    title='Education'
    description='Academic education of Rahul Pardhi, including B.Tech in Computer Science & Engineering, 12th & 10th grade credentials.'
>
    <div class='relative max-w-3xl mx-auto py-8 px-4 lg:px-0 w-full space-y-8'>
        <!-- Academic Degrees & Schooling -->
        <div class='space-y-6'>
            <div>
                <h2 class='text-2xl font-bold flex items-center gap-2 text-foreground'>
                    <GraduationCap size={24} class='text-primary' /> Academic Education
                </h2>
                <div class='h-1 w-32 bg-primary mt-2 mb-6 rounded-full'></div>
            </div>

            {
                educationList.map((item) => (
                    <Card className='bg-secondary-background border border-slate-200 dark:border-slate-800 shadow transition hover:shadow-md'>
                        <CardHeader className='flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2'>
                            <div class='space-y-1'>
                                <CardTitle className='text-xl font-bold text-foreground'>
                                    {item.degree}
                                </CardTitle>
                                <p class='text-sm font-semibold text-primary'>
                                    {item.major}
                                </p>
                                <CardDescription className='flex items-center gap-1.5 text-sm text-foreground/80'>
                                    <Building size={16} />
                                    {item.institution} • {item.location}
                                </CardDescription>
                            </div>

                            <div class='flex flex-col sm:items-end gap-1.5'>
                                <span class='inline-flex items-center rounded-md bg-primary/10 px-2.5 py-1 text-xs font-bold text-primary border border-primary/20'>
                                    {item.status}
                                </span>
                                <span class='flex items-center gap-1 text-xs text-foreground/60'>
                                    <History size={14} />
                                    {item.dates}
                                </span>
                            </div>
                        </CardHeader>

                        <CardContent>
                            <p class='text-sm text-foreground/80 leading-relaxed'>
                                {item.details}
                            </p>
                        </CardContent>
                    </Card>
                ))
            }
        </div>
    </div>
</Layout>
